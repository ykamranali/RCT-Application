# =====================================================================
# RCT APPLICATION | Ram Computer Technology LLC
# Copy to apps/web/.env.local and fill in. Never commit the filled copy.
# =====================================================================

# ---------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------
# Safe to expose to the browser - RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security completely.
# Never prefix with NEXT_PUBLIC_, never commit, rotate if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, used by the migration and seed scripts.
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the scheduled jobs at /api/cron/*.
# Generate with:  openssl rand -base64 32
CRON_SECRET=

# ---------------------------------------------------------------------
# Email
# These can also be set in the application at Settings -> Email, which
# stores them encrypted-at-rest in system_settings and hides them from
# every browser session. Environment variables are the fallback.
# ---------------------------------------------------------------------
EMAIL_PROVIDER=smtp          # smtp | resend

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls              # none | tls | ssl
SMTP_USERNAME=
SMTP_PASSWORD=

# Only needed when EMAIL_PROVIDER=resend
RESEND_API_KEY=

EMAIL_FROM=servicedesk@yourdomain.ae
EMAIL_FROM_NAME=RCT Service Desk
EMAIL_REPLY_TO=support@yourdomain.ae

# ---------------------------------------------------------------------
# Mobile application (apps/mobile/.env)
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=https://your-deployment.vercel.app
